# Copy to .env (scripts/setup.sh does this for you) and adjust.

# Password everyone needs to join. setup.sh asks for it if left empty.
SERVER_PASSWORD=

# Name shown in the server list and used for the world file (no spaces).
WORLD_NAME=OurWorld

# 1 = small, 2 = medium, 3 = large. Medium suits 6–8 players.
WORLD_SIZE=2

# 0 = classic, 1 = expert, 2 = master, 3 = journey. Only applies when the world is first created.
DIFFICULTY=1

MAX_PLAYERS=8
SERVER_PORT=7777

# TShock release to run. Must support the Terraria version your friends have.
TSHOCK_VERSION=6.2.0

# Used for log timestamps and the nightly backup.
TZ=Europe/Amsterdam

# How many nightly backups to keep.
BACKUP_KEEP_DAYS=14

# Discord join/leave notifications — set up with: sudo ./scripts/discord.sh
DISCORD_WEBHOOK_URL=
COMPOSE_PROFILES=
